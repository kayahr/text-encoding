{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile and watch project",
            "type": "shell",
            "command": "npm run build:compile -- --watch",
            "isBackground": true,
            "problemMatcher": [
                "$tsc-watch"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        },
        {
            "label": "Run unit tests",
            "command": "${command:testing.coverageAll}",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]
}
